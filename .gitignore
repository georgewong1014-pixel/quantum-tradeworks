node_modules
.vercel
.env
.env.local
.DS_Store
*.log

# local screenshot output (dev only)
temporary screenshots/

# end-of-day prices are supplied by you under your own licence
data/prices.json

# prices read off your own screen: personal research, never redistributable,
# so they must never reach the deployed site
data/personal-prices.json
data/watchlist-review*.csv
data/watchlist-review*.txt

# the accumulated series is built from those prices and inherits their terms
data/price-history.json
# ingest/history-store.mjs writes it atomically (.tmp renamed over it, the
# previous file kept as .bak), under a lock, and puts every row it refused in
# a rejects file — all of them the same prices, under the same terms.
data/price-history.json.tmp
data/price-history.json.bak
data/price-history.json.lock
data/price-history.json.lock.*
data/price-history.rejects.json
data/price-history.rejects.json.tmp
data/price-history.rejects.json.bak
# The corporate actions you record for that history (splits, consolidations),
# applied to it on read by the page and the scanner worker. It describes your
# own series and sits with them.
data/price-adjustments.json
data/price-adjustments.json.*

# where you drop watchlist screenshots. Someone else's licensed data rendered
# as pixels — never committed, never deployed.
watchlist-shots/

# what you track is your business, and this repository is public.
# watchlist-symbols.example.txt is the committed template.
watchlist-symbols.txt

# the browser profile the unattended capture signs in with. Contains live
# session cookies for your account — never commit this.
.chrome-watchlist/
*.state.json

# output of the daily run
data/daily-report.txt
data/daily-*.csv
data/daily-*.json
data/r[0-9].csv
data/r[0-9].txt
data/probe-*
data/scroll-probe.*
data/pp.bak.json

# The SEC ingest's raw archive: companyfacts and submissions bodies exactly as
# fetched, 1-10 MB each, kept so a normalisation rule can be re-run with
# --from-raw without the network. The SEC's to publish, not ours to commit.
# The committed fixture archive lives in ingest/fixtures/sec-raw.
ingest/raw/
# What the replacement gate writes instead of the file it refused to replace.
data/*.partial.json

# Household income cache — redistribution rights unconfirmed, see ingest/sarawak-geo.mjs
data/sarawak-income.json

# Malaysian annual statements pulled from an unlicensed endpoint. Personal
# research only, exactly like the prices above — never redistributable.
data/personal-fundamentals.json

# QT Trading Index. Your own reading of your own charts, and the chart images
# behind it — someone else's licensed data rendered as pixels, exactly like
# watchlist-shots. qtti/observations.example.json is the committed template.
qtti/observations.json
qtti/observations.draft.json
qtti/screenshots/
qtti/out/

# NAPIC / JPPH source files and the full extract taken from them.
#
# This repository is PUBLIC. Section 14 of the extraction specification keeps
# raw source files private and bulk export of NAPIC rows disabled until JPPH
# confirms commercial redistribution rights, and committing them here would be
# publishing them to the world — the single most consequential way this product
# could get the licence question wrong.
#
# What IS committed is data/napic-h1-2025.json: derived division-level summaries
# and the published benchmark ranges, with attribution. That is the
# "QT-generated analysis and derived summaries" the specification permits, and
# it is 987kB rather than 11MB. It is the source, and is not deployed
# (.vercelignore): build.mjs writes data/napic-h1-2025/<division>.json from
# it, one division a file, and those are what the site serves (plan item 1.6).
property-data/raw/
property-data/staging/
property-data/normalized/
property-data/rejects/

# Trade-setup scanner. Your setups are your business, and the alert record is
# derived from your own price history and inherits its terms. Neither reaches
# the deployed site. scanner/setups.example.json is the committed template.
data/scan-setups.json
data/scan-alerts.json
# The worker writes the record beside itself and keeps the previous one.
data/scan-alerts.json.tmp
data/scan-alerts.json.bak
# The worker's own files: the run log and audit, the lock, the pause switch
# and the delivery record. They name your setups, your instruments and the
# account that ran them, and they describe the alert record above.
data/scan-runs.json
data/scan-runs.json.*
data/scan.lock
data/scan.lock.*
data/scan-control.json
data/scan-control.json.*
data/scan-deliveries.json
data/scan-deliveries.json.*
# The daily run's own log (ingest/daily.mjs).
data/ingest-runs.json
data/ingest-runs.json.*
# The worker's version ledger: every version of every setup it has evaluated
# (append-only) and the bar each setup x instrument pair was last evaluated on,
# for catch-up. It names your setups and your instruments.
data/scan-ledger.json
data/scan-ledger.json.*
# The watchlist export a watchlist universe set to resolve from the export
# reads at run time (the watchlists page, "Export for the scanner"). It
# holds your lists and what is in them.
data/watchlists.json
data/watchlists.json.*

# Worktrees made by parallel agents (Claude Code). Never part of the product.
.claude/worktrees/
