.DS_Store
*.log

# local screenshot output (dev only)
temporary screenshots/

# end-of-day prices are supplied by you under your own licence
data/prices.json

# prices read off your own screen: personal research, never redistributable,
# so they must never reach the deployed site
data/personal-prices.json
data/watchlist-review*.csv
data/watchlist-review*.txt

# the accumulated series is built from those prices and inherits their terms
data/price-history.json

# where you drop watchlist screenshots. Someone else's licensed data rendered
# as pixels — never committed, never deployed.
watchlist-shots/

# what you track is your business, and this repository is public.
# watchlist-symbols.example.txt is the committed template.
watchlist-symbols.txt

# the browser profile the unattended capture signs in with. Contains live
# session cookies for your account — never commit this.
.chrome-watchlist/
*.state.json

# output of the daily run
data/daily-report.txt
data/daily-*.csv
data/daily-*.json
data/r[0-9].csv
data/r[0-9].txt
data/probe-*
data/scroll-probe.*
data/pp.bak.json

# Household income cache — redistribution rights unconfirmed, see ingest/sarawak-geo.mjs
data/sarawak-income.json

# Malaysian annual statements pulled from an unlicensed endpoint. Personal
# research only, exactly like the prices above — never redistributable.
data/personal-fundamentals.json

# QT Trading Index. Your own reading of your own charts, and the chart images
# behind it — someone else's licensed data rendered as pixels, exactly like
# watchlist-shots. qtti/observations.example.json is the committed template.
qtti/observations.json
qtti/observations.draft.json
qtti/screenshots/
qtti/out/

# NAPIC / JPPH source files and the full extract taken from them.
#
# This repository is PUBLIC. Section 14 of the extraction specification keeps
# raw source files private and bulk export of NAPIC rows disabled until JPPH
# confirms commercial redistribution rights, and committing them here would be
# publishing them to the world — the single most consequential way this product
# could get the licence question wrong.
#
# What IS committed is data/napic-h1-2025.json: derived division-level summaries
# and the published benchmark ranges, with attribution. That is the
# "QT-generated analysis and derived summaries" the specification permits, and
# it is 987kB rather than 11MB.
property-data/raw/
property-data/staging/
property-data/normalized/
property-data/rejects/
